# OpenAI compatible model service
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=

# FastAPI service
APP_HOST=127.0.0.1
APP_PORT=8000

# MySQL
DATABASE_URL=mysql+aiomysql://username:password@127.0.0.1:3306/trip_agents?charset=utf8mb4

# Loguru 日志
LOG_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true
LOG_LEVEL=INFO
LOG_RETENTION=14 days
LOG_ROTATION=00:00
# 相对路径相对项目根目录；默认项目根目录/logs
LOG_DIR=logs
LOG_ENCODING=utf-8
LOG_ENQUEUE=true
# 高德开放平台 api-key
AMAP_API_KEY=

AUTH_JWT_SECRET=